    "Log what's in your fridge and cupboards. Recipes will show which ones you can cook right now." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse, was in Kühlschrank und Schränken ist. Rezepte zeigen dir, was du sofort kochen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra lo que hay en tu nevera y armarios. Las recetas mostrarán cuáles puedes cocinar ahora mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez ce qu'il y a dans votre frigo et vos placards. Les recettes montrent ce que vous pouvez cuisiner tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra cosa c'è in frigo e nelle credenze. Le ricette mostrano cosa puoi cucinare subito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd bij wat er in je koelkast en kasten ligt. Bij recepten zie je wat je nu meteen kunt koken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj, co masz w lodówce i szafkach. Przepisy pokażą, co możesz ugotować od razu."
          }
        }
      }
    },
