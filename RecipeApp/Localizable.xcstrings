    "\"%@\" is planned %lld times in the future. Remove it from the calendar first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"%@\" is planned %lld time in the future. Remove it from the calendar first."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"%@\" is planned %lld times in the future. Remove it from the calendar first."
                }
              }
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" staat %lld keer ingepland in de toekomst. Verwijder het eerst uit de agenda."
          }
        }
      }
    },
    "\"%@\" is used in %@. Remove those references first.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" wordt gebruikt in %@. Verwijder die verwijzingen eerst."
          }
        }
      }
    },
    "\"%@\" was planned %lld times in the past. Those calendar entries will also be deleted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"%@\" was planned %lld time in the past. That calendar entry will also be deleted."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\"%@\" was planned %lld times in the past. Those calendar entries will also be deleted."
                }
              }
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" stond %lld keer ingepland in het verleden. Die agenda-items worden ook verwijderd."
          }
        }
      }
    },
