        }
      }
    },
    "Tap + to add an ingredient. Nutrition values are looked up automatically from the NEVO database.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op + om een ingrediënt toe te voegen. Voedingswaarden worden automatisch opgezocht in de NEVO-databank."
          }
        }
      }
    },
    "Tap + to create a recipe manually or import one from a URL.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op + om handmatig een recept te maken of importeer er een via een URL."
          }
        }
      }
    },
    "Tap + to schedule a recipe on any day. The calendar shows your full week at a glance.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op + om een recept op een dag in te plannen. De agenda toont je hele week in één oogopslag."
          }
        }
      }
    },
    "Tap the circle icon to select days, then tap the cart to get a shopping list for those meals.": {
