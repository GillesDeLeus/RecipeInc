<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PCODE1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<!-- Must exactly match the App Group ID in BRecipe.entitlements and PendingImportStore.appGroupID -->
		<string>group.brecipe.BRecipe</string>
	</array>
</dict>
</plist>
